{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Orbit Download Manager",
  "version": "1.1.3",
  "identifier": "com.HrshD1eux.orbitdownloadmanager",
  "build": {
    "beforeDevCommand": "pnpm --filter orbit-download-manager-frontend dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter orbit-download-manager-frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit Download Manager",
        "width": 840,
        "height": 540,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
